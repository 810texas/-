# 复制为 .env 并修改
# 数据库
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=你的密码
DB_NAME=invoice_system

# JWT
JWT_SECRET=change-me-to-a-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=7

# AI 服务切换（mock | paddle / mock | qwen | glm）
# 切真实 OCR：把 OCR_PROVIDER 改成 paddle（需先 pip install -r requirements.txt）
OCR_PROVIDER=mock
LLM_PROVIDER=mock

# PaddleOCR（OCR_PROVIDER=paddle 时生效）：本地 CPU 推理，发票影像与结果都不出本机
PADDLE_OCR_LANG=ch
PADDLE_OCR_USE_GPU=false
# 关闭 ppocr 的 DEBUG 日志（改 true 可看每次识别的详细参数与进度）
PADDLE_OCR_SHOW_LOG=false
# 离线部署用：留空＝首次识别自动联网下载模型到 ~/.paddleocr；填目录＝直接用现成模型
PADDLE_OCR_DET_MODEL_DIR=
PADDLE_OCR_REC_MODEL_DIR=
PADDLE_OCR_CLS_MODEL_DIR=

# CORS 来源（逗号分隔；开发期走 vite proxy 则无需放开）
CORS_ORIGINS=http://localhost:5173

# 抬头核验（公司主体，需求 4.4 待确认输入）
COMPANY_NAME=示例科技有限公司
COMPANY_TAX_NO=91330100MA2XXXXXXX

# 规则参数
OCR_CONFIDENCE_THRESHOLD=0.85
AMOUNT_TOLERANCE=0.01
BUDGET_WARN_RATIO=0.8

# 上传限制
MAX_UPLOAD_MB=10
UPLOAD_DIR=storage/uploads
