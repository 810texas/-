# 复制为 .env 并修改
# 数据库
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=你的密码
DB_NAME=invoice_system

# JWT
JWT_SECRET=change-me-to-a-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# AI 服务切换（mock | paddle / mock | qwen | glm）
OCR_PROVIDER=mock
LLM_PROVIDER=mock

# CORS 来源（逗号分隔；开发期走 vite proxy 则无需放开）
CORS_ORIGINS=http://localhost:5173
